{
  "name": "karemetin-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Offline AI subtitle editor and native video renderer",
  "author": "KareMetin",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "vite --mode desktop",
    "build": "tsc -b && vite build",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --win nsis portable",
    "lint": "oxlint src electron tests vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build && playwright test -c playwright.desktop.config.ts",
    "models:download:turbo": "py -3 scripts/download_bundled_model.py",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.karemetin.desktop",
    "productName": "KareMetin",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/@huggingface/jinja/**/*",
      "node_modules/@huggingface/tokenizers/**/*",
      "node_modules/@huggingface/tokenizers-win32-x64-msvc/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/sharp/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/bin/win32/x64/**/*"
    ],
    "extraFiles": [
      {
        "from": "TERMINAL-KULLANIM.md",
        "to": "TERMINAL-KULLANIM.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "KareMetin-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "KareMetin-Portable-${version}-${arch}.${ext}"
    }
  }
}
